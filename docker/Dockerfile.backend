# Backend Dockerfile (CPU-only)
# Uses Python slim base image for lightweight builds.

FROM python:3.10-slim

# Prevent interactive prompts during install
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    docker.io \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --timeout=600 --retries=3 -r requirements.txt

# Create a non-root user
RUN useradd -m -u 1000 appuser

# Copy application code
COPY backend/ .

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Change ownership to the non-root user
RUN chown -R appuser:appuser /app

# Switch to the non-root user
# USER appuser

# Flask env for CLI commands (flask db upgrade)
ENV FLASK_APP=run.py

# Expose port
EXPOSE 5000

# Auto-migrate then start the app
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "run.py"]
