# OpenCode Docker Image for InferX-ML
# Uses official npm package installation

FROM node:20-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    python3 \
    python3-pip \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCode CLI from npm (official package name is opencode-ai)
RUN npm install -g opencode-ai@latest

# Create workspace directory for generated projects
RUN mkdir -p /workspace
WORKDIR /workspace

# Environment variables
ENV OPENCODE_WORKSPACE=/workspace
ENV HOME=/root

# Expose server port (for serve mode)
EXPOSE 8741

# Default command - run opencode
ENTRYPOINT ["opencode"]
CMD ["--help"]